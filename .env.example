# --- AI (required for AI Auto-Clip, metadata generation) ---
# Use EITHER OpenRouter OR Anthropic. If both are set, OpenRouter wins.
#
# Option A - OpenRouter (one key, many models incl. Claude). Recommended if you
# already have an OpenRouter key. Pick any model slug from openrouter.ai/models,
# e.g. anthropic/claude-3.5-sonnet, anthropic/claude-3.7-sonnet, openai/gpt-4o.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Option B - Anthropic native (leave blank if you use OpenRouter above).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Whisper transcription ---
# Models: tiny | small | medium | large-v3 (large-v3 = best Hebrew, needs GPU)
WHISPER_MODEL=small
# auto = try CUDA then fall back to CPU
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Live recording ---
LIVE_POLL_INTERVAL_SEC=300
DISK_MIN_FREE_GB=5
SEGMENT_TIME_SEC=600

# --- Jobs ---
QUEUE_CONCURRENCY=1

# --- Tool path overrides (leave empty to use PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
STREAMLINK_PATH=streamlink

# --- UI ---
UI_LANGUAGE=he
