# --- AI (required for AI Auto-Clip, metadata generation) ---
# Use EITHER OpenRouter OR Anthropic. If both are set, OpenRouter wins.
#
# Option A - OpenRouter (one key, many models). Recommended.
# Default is a CHEAP Chinese model (DeepSeek V3): ~$0.23/$0.34 per 1M tokens,
# roughly 40-50x cheaper than Claude, good at JSON, decent Hebrew.
# Cheap alternatives (pick one for OPENROUTER_MODEL):
#   deepseek/deepseek-chat            <- default, best value
#   qwen/qwen-2.5-72b-instruct        <- cheap, strong multilingual
#   deepseek/deepseek-r1              <- reasoning, still cheap
#   z-ai/glm-4.5-air                  <- very cheap
# Stronger (pricier) if Hebrew titles come out weak:
#   anthropic/claude-3.5-sonnet  |  openai/gpt-4o
# Free (rate-limited, slugs change - see openrouter.ai/models?max_price=0):
#   deepseek/deepseek-chat-v3-0324:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Option B - Anthropic native (leave blank if you use OpenRouter above).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Whisper transcription ---
# Models: tiny | small | medium | large-v3 (large-v3 = best Hebrew, needs GPU)
WHISPER_MODEL=small
# auto = try CUDA then fall back to CPU
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Live recording ---
LIVE_POLL_INTERVAL_SEC=300
DISK_MIN_FREE_GB=5
SEGMENT_TIME_SEC=600

# --- Jobs ---
QUEUE_CONCURRENCY=1

# --- Tool path overrides (leave empty to use PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
STREAMLINK_PATH=streamlink

# --- UI ---
UI_LANGUAGE=he
